# Contact form (server-side only — never exposed to the browser).
# Set these in Vercel → Project → Settings → Environment Variables.

# Resend API key (create one in your Resend dashboard → API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered (your Gmail).
CONTACT_TO=you@gmail.com

# The "from" address. Use an address on a domain you've verified in Resend for
# best deliverability, e.g. "ArkSim <hello@yourdomain.com>". If you don't set
# this, the shared "onboarding@resend.dev" is used, which only delivers to your
# own Resend account email.
CONTACT_FROM=ArkSim <hello@yourdomain.com>

# Optional: only if you ever host the site under a sub-path (not on Vercel root).
# NEXT_PUBLIC_BASE_PATH=
